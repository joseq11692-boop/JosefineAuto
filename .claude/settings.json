{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_description": "Reglas del dueño (docs/reglas). allow: lecturas y gate sin preguntar. deny: destructivos y secretos. commit y push no se preautorizan. Stop: gate al cerrar cada turno si hay cambios. SessionStart: activa el pre-push de .githooks.",
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(python3 herramientas/check.py)", "Bash(python3 herramientas/check.py:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git show:*)", "Bash(git branch:*)", "Bash(git add:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard:*)", "Bash(git clean:*)", "Bash(git stash -u:*)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)", "Read(**/.env.production)",
      "Read(**/secrets/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks || true" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh", "timeout": 300 }] }
    ]
  }
}
